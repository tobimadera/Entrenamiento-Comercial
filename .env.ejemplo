# Copie este archivo con el nombre  .env  y complete los valores (sin comillas).
# NUNCA comparta el archivo .env: contiene las claves de acceso.

# Clave de Anthropic (console.anthropic.com > API keys). Obligatoria.
ANTHROPIC_API_KEY=

# Modelo de Claude para la devolución. Vacío = claude-opus-5-5.
MODELO=
# Modelo de Claude para el diálogo con el dueño. Vacío = claude-sonnet-5-5 (responde rápido).
MODELO_DIALOGO=

# Código del gestor: entra al panel (dirección /gestor), crea los códigos personales de cada
# consultor y ve sus entrenamientos. Obligatorio si se publica en internet.
CODIGO_GESTOR=

# Código compartido opcional para practicar sin identificarse (por ejemplo, un tester externo).
# Las prácticas con este código aparecen en el panel como "sin código personal".
# Sin CODIGO_GESTOR ni CODIGO_ACCESO no hay ningún control (solo para uso en la propia PC).
CODIGO_ACCESO=

# Carpeta donde se guardan las conversaciones. Vacío = datos. En Railway: la carpeta del volumen.
DATOS_DIR=

# Clave de ElevenLabs (elevenlabs.io > Developers > API Keys) para hablar por voz.
# Necesita permiso de Text to Speech y Speech to Text. Vacío = solo texto.
# Las voces de cada país se eligen en config/voces.yaml.
ELEVENLABS_API_KEY=

# Clave de Simli (app.simli.com > API key) para mostrar la cara del dueño hablando.
# Necesita también la clave de ElevenLabs. Vacío = solo voz. Las caras se eligen en config/voces.yaml.
SIMLI_API_KEY=
