# Copie este archivo con el nombre  .env  y complete los valores (sin comillas).
# NUNCA comparta el archivo .env: contiene las claves de acceso.

# Clave de Anthropic (console.anthropic.com > API keys). Obligatoria.
ANTHROPIC_API_KEY=

# Modelo de Claude. Vacío = claude-opus-5-5.
MODELO=

# Código que la página pide antes de dejar entrar. Obligatorio si se publica en internet:
# sin él, cualquiera con el enlace consume saldo de la clave. Vacío = sin control (uso local).
CODIGO_ACCESO=

# Carpeta donde se guardan las conversaciones. Vacío = datos. En Railway: la carpeta del volumen.
DATOS_DIR=

# Fase 2 (voz). Todavía no se usan.
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ_AR=
ELEVENLABS_VOZ_BR=
